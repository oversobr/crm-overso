# ═══════════════════════════════════════════════════════════════════
# CRM OVERSO — configuração do Apache na raiz do portal.overso.co
#
# O painel é uma SPA: o roteamento (/leads, /funil, …) acontece no
# navegador, não no servidor. Sem as regras abaixo, abrir /leads direto
# ou dar F5 dentro do painel devolve 404 do Apache.
#
# Este arquivo é copiado para dist/client/ pelo workflow de deploy.
# ═══════════════════════════════════════════════════════════════════

# ── Rotas da SPA ───────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Requisição que bate em arquivo ou pasta de verdade é servida direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto é rota do painel: entrega o index.html e o router resolve.
  RewriteRule ^ index.html [L]
</IfModule>

# ── Cache ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Só o que está em /assets/ tem hash no nome (index-D3bnH1x4.js), então
  # só isso pode ficar em cache pra sempre — nome novo a cada build.
  SetEnvIf Request_URI "^/assets/" OVERSO_IMUTAVEL=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=OVERSO_IMUTAVEL

  # index.html não pode ser cacheado, senão o deploy novo não aparece pro
  # usuário. overso-lead-wp.js também não: as LPs dos clientes apontam pra
  # esse endereço fixo e precisam receber as correções.
  <FilesMatch "^(index\.html|overso-lead-wp\.js)$">
    # O mod_expires da hospedagem roda DEPOIS do mod_headers e reescreve o
    # max-age (o tracker vinha com 4h de cache). Desligado aqui, o Header
    # abaixo é o que vale.
    <IfModule mod_expires.c>
      ExpiresActive Off
    </IfModule>
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compressão ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Básico ─────────────────────────────────────────────────────────
DirectoryIndex index.html
Options -Indexes
