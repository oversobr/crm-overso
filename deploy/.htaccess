# ═══════════════════════════════════════════════════════════════════
# CRM OVERSO — configuração do Apache na raiz do portal.overso.co
#
# O painel é uma SPA: o roteamento (/leads, /funil, …) acontece no
# navegador, não no servidor. Sem as regras abaixo, abrir /leads direto
# ou dar F5 dentro do painel devolve 404 do Apache.
#
# Este arquivo é copiado para dist/client/ pelo workflow de deploy.
# ═══════════════════════════════════════════════════════════════════

# ── Rotas da SPA ───────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Requisição que bate em arquivo ou pasta de verdade é servida direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto é rota do painel: entrega o index.html e o router resolve.
  RewriteRule ^ index.html [L]
</IfModule>

# ── Cache ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Só o que está em /assets/ tem hash no nome (index-D3bnH1x4.js), então
  # só isso pode ficar em cache pra sempre — nome novo a cada build.
  SetEnvIf Request_URI "^/assets/" OVERSO_IMUTAVEL=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=OVERSO_IMUTAVEL

  # index.html não pode ser cacheado, senão o deploy novo não aparece pro
  # usuário. overso-lead-wp.js também não: as LPs dos clientes apontam pra
  # esse endereço fixo e precisam receber as correções.
  <FilesMatch "^(index\.html|overso-lead-wp\.js)$">
    # O mod_expires da hospedagem roda DEPOIS do mod_headers e reescreve o
    # max-age (o tracker vinha com 4h de cache). Desligado aqui, o Header
    # abaixo é o que vale.
    <IfModule mod_expires.c>
      ExpiresActive Off
    </IfModule>
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Segurança ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # O portal não pode ser aberto dentro de outro site: é como se monta uma
  # página falsa por cima para roubar cliques de quem está logado.
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  # O navegador não adivinha o tipo de um arquivo: vale o que o servidor diz.
  Header always set X-Content-Type-Options "nosniff"
  # Ao sair do portal por um link, o endereço interno não viaja junto.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # O portal não usa câmera, microfone nem localização.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Sempre por HTTPS, por um ano.
  Header always set Strict-Transport-Security "max-age=31536000"

  # O script das landing pages roda dentro dos sites dos clientes e precisa
  # continuar carregável de lá.
  <FilesMatch "^overso-lead-wp\.js$">
    Header always unset X-Frame-Options
    Header always unset Content-Security-Policy
  </FilesMatch>
</IfModule>

# ── Compressão ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Básico ─────────────────────────────────────────────────────────
DirectoryIndex index.html
Options -Indexes
